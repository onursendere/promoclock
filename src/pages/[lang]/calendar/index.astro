---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { i18n, type Locale } from "@/lib/i18n/config";
import { getDictionary } from "@/lib/i18n/dictionaries";
import { getEvents, getTools } from "@/lib/content";
import { localize } from "@/lib/deals";
import { breadcrumbJsonLd } from "@/lib/jsonld";
import { absoluteUrl, localePath } from "@/lib/seo";
import { BUILD_TIME } from "@/lib/site";
import { formatDate } from "@/lib/time";
import { PageHeader } from "@/components/site/PageHeader";
import { CalendarMonths, PastEvents, type CalendarEntry } from "@/components/site/CalendarMonths";
import { NoDeals } from "@/components/site/NoDeals";

export function getStaticPaths() {
  return i18n.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const dict = getDictionary(lang);
const { hub } = dict;
const t = hub.calendar;
const [events, tools] = await Promise.all([getEvents(), getTools()]);
const toolsBySlug = Object.fromEntries(tools.map((tool) => [tool.slug, tool]));

const withHref = (e: (typeof events)[number]): CalendarEntry => ({
  ...e,
  href:
    e.deal && e.tool
      ? `${localePath(lang, `tools/${e.tool}`)}#${e.deal}`
      : e.tool
        ? localePath(lang, `tools/${e.tool}`)
        : e.url,
});
const upcoming = events.filter((e) => (e.endDate ?? e.date) >= BUILD_TIME).map(withHref);
const past = events.filter((e) => (e.endDate ?? e.date) < BUILD_TIME).reverse().slice(0, 10).map(withHref);

const months: { label: string; events: CalendarEntry[] }[] = [];
for (const event of upcoming) {
  const label = formatDate(event.date, lang, { day: undefined, month: "long", year: "numeric" });
  const month = months.find((m) => m.label === label);
  if (month) month.events.push(event);
  else months.push({ label, events: [event] });
}

const jsonLd = [
  ...upcoming.map((event) => ({
    "@context": "https://schema.org",
    "@type": "Event",
    name: localize(event.title, lang),
    startDate: new Date(event.date).toISOString(),
    ...(event.endDate ? { endDate: new Date(event.endDate).toISOString() } : {}),
    eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
    eventStatus: "https://schema.org/EventScheduled",
    location: { "@type": "VirtualLocation", url: absoluteUrl(event.href ?? localePath(lang, "calendar")) },
    ...(event.description ? { description: localize(event.description, lang) } : {}),
  })),
  breadcrumbJsonLd([
    { name: "PromoClock", path: localePath(lang) },
    { name: hub.nav.calendar, path: localePath(lang, "calendar") },
  ]),
];
---

<BaseLayout lang={lang} dict={dict} path="calendar" title={t.metaTitle} description={t.metaDescription} jsonLd={jsonLd}>
  <PageHeader crumbs={[{ label: "PromoClock", href: localePath(lang) }, { label: hub.nav.calendar }]} title={t.title} description={t.subtitle} />
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-12 px-4 py-10 sm:px-6">
    <section class="flex flex-col gap-4" aria-labelledby="upcoming-events">
      <h2 id="upcoming-events" class="text-lg font-semibold tracking-tight">{t.upcoming}</h2>
      {
        months.length > 0 ? (
          <CalendarMonths months={months} tools={toolsBySlug} lang={lang} now={BUILD_TIME} />
        ) : (
          <NoDeals message={t.empty} href={localePath(lang, "deals")} label={hub.nav.deals} />
        )
      }
    </section>
    {
      past.length > 0 && (
        <section class="flex flex-col gap-4" aria-labelledby="past-events">
          <h2 id="past-events" class="text-lg font-semibold tracking-tight">
            {t.past}
          </h2>
          <PastEvents events={past} lang={lang} />
        </section>
      )
    }
  </div>
</BaseLayout>
