---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { i18n, type Locale } from "@/lib/i18n/config";
import { getDictionary } from "@/lib/i18n/dictionaries";
import { localePath } from "@/lib/seo";
import { PageHeader } from "@/components/site/PageHeader";
import { DisclosureCard } from "@/components/site/DisclosureCard";

export function getStaticPaths() {
  return i18n.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const dict = getDictionary(lang);
const t = dict.hub.disclosure;
---

<BaseLayout lang={lang} dict={dict} path="affiliate-disclosure" title={t.metaTitle} description={t.metaDescription}>
  <PageHeader crumbs={[{ label: "PromoClock", href: localePath(lang) }, { label: dict.hub.common.disclosureLink }]} title={t.title} />
  <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <DisclosureCard paragraphs={t.paragraphs} />
  </div>
</BaseLayout>
