---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { i18n, type Locale } from "@/lib/i18n/config";
import { format, getDictionary } from "@/lib/i18n/dictionaries";
import { getDeals, getTools } from "@/lib/content";
import { lastVerified, partitionDeals, type DealRecord, type ToolRecord } from "@/lib/deals";
import { breadcrumbNode, itemListNode, softwareNode, webPageNode } from "@/lib/jsonld";
import { absoluteUrl, dealPath, localePath } from "@/lib/seo";
import { formatDate } from "@/lib/time";
import { localize } from "@/lib/deals";
import { BUILD_TIME } from "@/lib/site";
import { ToolHero } from "@/components/site/ToolHero";
import { DealCard } from "@/components/site/DealCard";
import { DealTimeline } from "@/components/site/DealTimeline";
import { ToolCard } from "@/components/site/ToolCard";
import { NoDeals } from "@/components/site/NoDeals";
import { AffiliateNote } from "@/components/site/AffiliateNote";

export async function getStaticPaths() {
  const [tools, deals] = await Promise.all([getTools(), getDeals()]);
  const liveByTool = Object.fromEntries(
    tools.map((t) => [t.slug, partitionDeals(deals.filter((d) => d.tool === t.slug), BUILD_TIME).live.length]),
  );
  return i18n.locales.flatMap((lang) =>
    tools.map((tool) => ({
      params: { lang, slug: tool.slug },
      props: {
        tool,
        deals: deals.filter((d) => d.tool === tool.slug),
        related: tools.filter((t) => t.category === tool.category && t.slug !== tool.slug).slice(0, 6),
        liveByTool,
      },
    })),
  );
}

interface Props {
  tool: ToolRecord;
  deals: DealRecord[];
  related: ToolRecord[];
  liveByTool: Record<string, number>;
}

const lang = Astro.params.lang as Locale;
const { tool, deals, related, liveByTool } = Astro.props;
const dict = getDictionary(lang);
const { hub } = dict;
const t = hub.tools;
const { live, upcoming, archive } = partitionDeals(deals, BUILD_TIME);
const current = [...live, ...upcoming];
const month = formatDate(BUILD_TIME, lang, { day: undefined, month: "short" });
const title = format(t.toolMetaTitle, { name: tool.name, month });
const description = format(t.toolMetaDescription, { name: tool.name, month });

const url = absoluteUrl(localePath(lang, `tools/${tool.slug}`));
const jsonLd = [
  webPageNode({
    url,
    name: title,
    description,
    lang,
    dateModified: deals.length ? lastVerified(deals) : undefined,
    about: softwareNode(tool, lang, hub.categories[tool.category]),
  }),
  ...(deals.length
    ? [itemListNode(t.currentDeals, deals.map((d) => ({ name: localize(d.headline, lang), url: absoluteUrl(dealPath(lang, d.id)) })))]
    : []),
  breadcrumbNode([
    { name: "PromoClock", path: localePath(lang) },
    { name: hub.nav.tools, path: localePath(lang, "tools") },
    { name: tool.name, path: localePath(lang, `tools/${tool.slug}`) },
  ]),
];
---

<BaseLayout lang={lang} dict={dict} path={`tools/${tool.slug}`} title={title} description={description} jsonLd={jsonLd} hub>
  <ToolHero tool={tool} lang={lang} hub={hub} liveCount={live.length} />
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-8 sm:gap-14 sm:px-6 sm:py-10">
    {tool.body && <p class="max-w-3xl leading-relaxed text-muted-foreground">{tool.body}</p>}

    <section class="flex flex-col gap-4" aria-labelledby="current-deals">
      <h2 id="current-deals" class="text-xl font-semibold tracking-tight">{t.currentDeals}</h2>
      {
        current.length > 0 ? (
          <div data-live-list class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {current.map((deal) => (
              <div>
                <DealCard deal={deal} tool={tool} lang={lang} hub={hub} now={BUILD_TIME} hideTool />
              </div>
            ))}
          </div>
        ) : (
          <NoDeals message={t.noLiveDeals} href={localePath(lang, "deals")} label={hub.nav.deals} />
        )
      }
    </section>

    {
      archive.length > 0 && (
        <section class="flex flex-col gap-4" aria-labelledby="past-deals">
          <h2 id="past-deals" class="text-xl font-semibold tracking-tight">
            {t.pastDeals}
          </h2>
          <DealTimeline deals={archive} lang={lang} hub={hub} />
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="flex flex-col gap-4" aria-labelledby="related-tools">
          <h2 id="related-tools" class="text-xl font-semibold tracking-tight">
            {hub.categories[tool.category]}
          </h2>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <ToolCard tool={r} liveCount={liveByTool[r.slug] ?? 0} lang={lang} hub={hub} />
            ))}
          </div>
        </section>
      )
    }

    <AffiliateNote lang={lang} hub={hub} />
  </div>
</BaseLayout>
