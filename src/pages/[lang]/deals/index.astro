---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { i18n, type Locale } from "@/lib/i18n/config";
import { format, getDictionary } from "@/lib/i18n/dictionaries";
import { getDeals, getTools, toolMap } from "@/lib/content";
import { DEAL_KINDS, lastVerified, localize, partitionDeals } from "@/lib/deals";
import { breadcrumbNode, itemListNode, webPageNode } from "@/lib/jsonld";
import { absoluteUrl, dealPath, localePath } from "@/lib/seo";
import { formatDate } from "@/lib/time";
import { BUILD_TIME } from "@/lib/site";
import { PageHeader } from "@/components/site/PageHeader";
import { DealCard } from "@/components/site/DealCard";
import { AffiliateNote } from "@/components/site/AffiliateNote";
import { Badge } from "@/components/ui/badge";
import DealFilters from "@/components/islands/DealFilters";

export function getStaticPaths() {
  return i18n.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const dict = getDictionary(lang);
const { hub } = dict;
const t = hub.deals;
const [tools, deals] = await Promise.all([getTools(), getDeals()]);
const byTool = toolMap(tools);
const { live, upcoming, archive } = partitionDeals(deals, BUILD_TIME);
const recent = archive.slice(0, 12);
const shown = [...live, ...upcoming, ...recent];
const kindOptions = DEAL_KINDS.map((kind) => ({
  value: kind,
  label: hub.kinds[kind],
  count: shown.filter((d) => d.kind === kind).length,
})).filter((o) => o.count > 0);

const sections = [
  { id: "live", title: t.live, deals: live, live: true },
  { id: "upcoming", title: t.upcoming, deals: upcoming, live: false },
  { id: "archive", title: t.archive, deals: recent, live: false },
].filter((s) => s.deals.length > 0);

const month = formatDate(BUILD_TIME, lang, { day: undefined, month: "short" });
const title = format(t.metaTitle, { month });
const description = format(t.metaDescription, { month });
const url = absoluteUrl(localePath(lang, "deals"));
const jsonLd = [
  webPageNode({ url, name: title, description, lang, type: "CollectionPage", dateModified: lastVerified(deals), speakable: ["h1"] }),
  itemListNode(
    t.title,
    live.map((deal) => ({
      name: `${byTool.get(deal.tool)?.name ?? deal.tool}: ${localize(deal.headline, lang)}`,
      url: absoluteUrl(dealPath(lang, deal.id)),
    })),
  ),
  breadcrumbNode([
    { name: "PromoClock", path: localePath(lang) },
    { name: hub.nav.deals, path: localePath(lang, "deals") },
  ]),
];
---

<BaseLayout lang={lang} dict={dict} path="deals" title={title} description={description} jsonLd={jsonLd} hub>
  <PageHeader
    crumbs={[{ label: "PromoClock", href: localePath(lang) }, { label: hub.nav.deals }]}
    title={t.title}
    description={t.subtitle}
  />
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-10 sm:px-6">
    <DealFilters client:load root="#deals-root" allLabel={t.filterAll} emptyLabel={t.empty} options={kindOptions} total={shown.length} />
    <div id="deals-root" class="flex flex-col gap-12">
      {
        sections.map((section) => (
          <section data-deal-section class="flex flex-col gap-4" aria-labelledby={`deals-${section.id}`}>
            <div class="flex items-center gap-2">
              <h2 id={`deals-${section.id}`} class="text-lg font-semibold tracking-tight">
                {section.title}
              </h2>
              <Badge variant="secondary" className="font-mono">
                {section.deals.length}
              </Badge>
            </div>
            <div data-live-list={section.live ? "" : undefined} class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
              {section.deals.map((deal) => (
                <div data-deal-item>
                  <DealCard deal={deal} tool={byTool.get(deal.tool)} lang={lang} hub={hub} now={BUILD_TIME} />
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <AffiliateNote lang={lang} hub={hub} />
  </div>
</BaseLayout>
