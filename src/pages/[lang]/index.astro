---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import { i18n, type Locale } from "@/lib/i18n/config";
import { getDictionary, legacyCase } from "@/lib/i18n/dictionaries";
import { getDeals, getEvents, getTools, toolMap } from "@/lib/content";
import { getDealStatus, isLive, localize, partitionDeals } from "@/lib/deals";
import { faqJsonLd, softwareAppJsonLd, websiteJsonLd } from "@/lib/jsonld";
import { localePath } from "@/lib/seo";
import { BUILD_TIME, SITE_URL } from "@/lib/site";
import { scheduleRows } from "@/lib/schedule";
import { formatDate } from "@/lib/time";
import { PEAK_HOURS } from "@/data/claude";
import ClaudeWatch from "@/components/islands/ClaudeWatch";
import FaqAccordion from "@/components/islands/FaqAccordion";
import ApiTabs from "@/components/islands/ApiTabs";
import { HeroIntro } from "@/components/site/HeroIntro";
import { SponsorItem } from "@/components/site/SponsorItem";
import { StatCards, type Stat } from "@/components/site/StatCards";
import { DealCard } from "@/components/site/DealCard";
import { ToolCard } from "@/components/site/ToolCard";
import { HowItWorks } from "@/components/site/HowItWorks";
import { Eligibility } from "@/components/site/Eligibility";
import { ScheduleCard } from "@/components/site/ScheduleCard";
import { DealTimeline } from "@/components/site/DealTimeline";
import { AffiliateNote } from "@/components/site/AffiliateNote";

export function getStaticPaths() {
  return i18n.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const dict = getDictionary(lang);
const { hub } = dict;
const caseClass = legacyCase(lang);
const [tools, deals, events] = await Promise.all([getTools(), getDeals(), getEvents()]);
const byTool = toolMap(tools);

const claudeDeals = deals.filter((d) => d.tool === "claude");
const dates = Object.fromEntries(
  claudeDeals.map((d) => [
    d.id,
    {
      starts: formatDate(d.startsAt, lang),
      ends: d.endsAt === undefined ? undefined : formatDate(d.endsAt, lang),
      verified: formatDate(d.verifiedAt, lang),
    },
  ]),
);

const { live } = partitionDeals(deals.filter((d) => d.tool !== "claude"), BUILD_TIME);
const allLive = deals.filter((d) => isLive(getDealStatus(d, BUILD_TIME)));
const liveByTool = new Map<string, number>();
for (const d of allLive) liveByTool.set(d.tool, (liveByTool.get(d.tool) ?? 0) + 1);

const history = claudeDeals
  .filter((d) => {
    const status = getDealStatus(d, BUILD_TIME);
    return status === "ended" || status === "past";
  })
  .sort((a, b) => b.startsAt - a.startsAt);

const nextDeadline = events.find((e) => e.kind === "deadline" && e.date > BUILD_TIME);
const stats: Stat[] = [
  {
    label: hub.home.statsLive,
    value: String(allLive.length),
    footnote: [...new Set(allLive.map((d) => byTool.get(d.tool)?.name))].filter(Boolean).slice(0, 4).join(", "),
    icon: "tag",
  },
  { label: hub.home.statsTools, value: String(tools.length), footnote: Object.values(hub.categories).slice(0, 3).join(" · "), icon: "layers" },
  {
    label: hub.home.statsDeadline,
    value: nextDeadline ? formatDate(nextDeadline.date, lang, { year: undefined }) : "—",
    footnote: nextDeadline ? localize(nextDeadline.title, lang) : hub.home.statsDeadlineNone,
    icon: "calendar",
  },
  { label: hub.home.statsLanguages, value: String(i18n.locales.length), footnote: i18n.locales.join(" · ").toUpperCase(), icon: "globe" },
];

const snippets = [
  {
    id: "curl",
    label: "curl",
    code: `curl -s ${SITE_URL}/api/status | python3 -c "import sys,json;d=json.load(sys.stdin);print(d['emoji'],d['label'])"`,
  },
  {
    id: "zsh",
    label: "zsh prompt",
    code: `# Add to ~/.zshrc
claude_status() {
  curl -s ${SITE_URL}/api/status | \\
    python3 -c "import sys,json;d=json.load(sys.stdin);print(d['emoji'])" 2>/dev/null || echo '⏳'
}
RPROMPT='$(claude_status)'`,
  },
  { id: "deals", label: "/api/deals", code: `curl -s "${SITE_URL}/api/deals?status=active" | python3 -m json.tool` },
];
---

<BaseLayout
  lang={lang}
  dict={dict}
  title={dict.meta.title}
  description={dict.meta.description}
  ogTitle={dict.meta.ogTitle}
  ogDescription={dict.meta.ogDescription}
  jsonLd={[websiteJsonLd(lang, dict), softwareAppJsonLd(lang, dict), faqJsonLd(dict.faq.items)]}
>
  <section class="relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(var(--color-border)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_40%,transparent_100%)] bg-size-[22px_22px]"
    >
    </div>
    <div
      class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,460px)] lg:gap-14 lg:py-20"
    >
      <HeroIntro
        hub={hub}
        dealsHref={localePath(lang, "deals")}
        toolsHref={localePath(lang, "tools")}
        featuredTools={["claude", "gemini", "cursor", "perplexity", "notion", "elevenlabs"].map((s) => byTool.get(s)!).filter(Boolean)}
        toolCount={tools.length}
        liveCount={allLive.length}
      />
      <ClaudeWatch
        client:load
        lang={lang}
        hero={dict.hero}
        watch={hub.claudeWatch}
        common={hub.common}
        kinds={hub.kinds}
        deals={claudeDeals}
        dates={dates}
        buildTime={BUILD_TIME}
        peakEnabled={PEAK_HOURS.enabled}
        peakDocumented={PEAK_HOURS.documented}
        caseClass={caseClass}
      />
    </div>
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 pb-16 sm:px-6">
      <SponsorItem dict={dict} />
      <StatCards stats={stats} />
    </div>
  </section>

  {
    live.length > 0 && (
      <Section
        id="live-deals"
        title={hub.home.dealsTitle}
        description={hub.home.dealsSubtitle}
        actionHref={localePath(lang, "deals")}
        actionLabel={hub.home.dealsCta}
        muted
      >
        <div data-live-list class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {live.slice(0, 6).map((deal) => (
            <div>
              <DealCard deal={deal} tool={byTool.get(deal.tool)} lang={lang} hub={hub} now={BUILD_TIME} />
            </div>
          ))}
        </div>
        <AffiliateNote lang={lang} hub={hub} />
      </Section>
    )
  }

  <Section
    id="tools"
    title={hub.home.toolsTitle}
    description={hub.home.toolsSubtitle}
    actionHref={localePath(lang, "tools")}
    actionLabel={hub.home.toolsCta}
  >
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tools.slice(0, 9).map((tool) => <ToolCard tool={tool} liveCount={liveByTool.get(tool.slug) ?? 0} lang={lang} hub={hub} />)}
    </div>
  </Section>

  <Section id="how-it-works" title={dict.howItWorks.title} description={dict.howItWorks.subtitle} titleClassName={caseClass} muted>
    <HowItWorks dict={dict} caseClass={caseClass} />
  </Section>

  <Section id="eligibility" title={dict.eligibility.title} description={dict.eligibility.subtitle} titleClassName={caseClass}>
    <Eligibility dict={dict} />
  </Section>

  <Section id="schedule" title={dict.schedule.title} description={dict.schedule.subtitle} titleClassName={caseClass} muted>
    <ScheduleCard dict={dict} rows={scheduleRows(BUILD_TIME)} />
  </Section>

  <Section id="faq" title={dict.faq.title} description={dict.faq.subtitle} titleClassName={caseClass}>
    <FaqAccordion client:visible items={dict.faq.items} />
  </Section>

  <Section id="developer-tools" title={dict.devTools.title} description={dict.devTools.subtitle} titleClassName={caseClass} muted>
    <ApiTabs
      client:visible
      title={dict.devTools.apiTitle}
      description={dict.devTools.apiDescription}
      copyLabel={hub.common.copy}
      copiedLabel={hub.common.copied}
      snippets={snippets}
      links={[
        { href: "/api/status", label: "/api/status" },
        { href: "/api/deals", label: "/api/deals" },
        { href: "/api/tools.json", label: "/api/tools.json" },
      ]}
    />
  </Section>

  {
    history.length > 0 && (
      <Section id="promotion-history" title={hub.home.historyTitle} description={hub.home.historySubtitle}>
        <DealTimeline deals={history} lang={lang} hub={hub} />
      </Section>
    )
  }
</BaseLayout>
