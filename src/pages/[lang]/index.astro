---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import { i18n, type Locale } from "@/lib/i18n/config";
import { getDictionary, isHubTranslated, legacyCase } from "@/lib/i18n/dictionaries";
import { getDeals, getEvents, getTools, toolMap } from "@/lib/content";
import { getDealStatus, isLive, lastVerified, localize, partitionDeals } from "@/lib/deals";
import { faqNode, itemListNode, webPageNode } from "@/lib/jsonld";
import { absoluteUrl, dealPath, localePath } from "@/lib/seo";
import { BUILD_TIME, SITE_URL } from "@/lib/site";
import { scheduleRows } from "@/lib/schedule";
import { formatDate } from "@/lib/time";
import { PEAK_HOURS } from "@/data/claude";
import ClaudeWatch from "@/components/islands/ClaudeWatch";
import FaqAccordion from "@/components/islands/FaqAccordion";
import ApiTabs from "@/components/islands/ApiTabs";
import { HeroActions, HeroHeading } from "@/components/site/HeroIntro";
import { SponsorItem } from "@/components/site/SponsorItem";
import { StatCards, type Stat } from "@/components/site/StatCards";
import { DealCard } from "@/components/site/DealCard";
import { ToolTiles } from "@/components/site/ToolTiles";
import { PeakFacts } from "@/components/site/PeakFacts";
import { ScheduleCard } from "@/components/site/ScheduleCard";
import { DealTimeline } from "@/components/site/DealTimeline";
import { AffiliateNote } from "@/components/site/AffiliateNote";

export function getStaticPaths() {
  return i18n.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const dict = getDictionary(lang);
const { hub } = dict;
const caseClass = legacyCase(lang);
const [tools, deals, events] = await Promise.all([getTools(), getDeals(), getEvents()]);
const byTool = toolMap(tools);

const claudeDeals = deals.filter((d) => d.tool === "claude");
const links = Object.fromEntries(claudeDeals.map((d) => [d.id, { href: dealPath(lang, d.id), date: formatDate(d.startsAt, lang) }]));
const { live } = partitionDeals(deals.filter((d) => d.tool !== "claude"), BUILD_TIME);
const allLive = deals.filter((d) => isLive(getDealStatus(d, BUILD_TIME)));
const liveByTool: Record<string, number> = {};
for (const d of allLive) liveByTool[d.tool] = (liveByTool[d.tool] ?? 0) + 1;

const history = claudeDeals
  .filter((d) => d.startsAt <= BUILD_TIME)
  .sort((a, b) => b.startsAt - a.startsAt);
const peakSource = claudeDeals.find((d) => d.id === "claude-peak-hours-introduced");

const nextDeadline = events.find((e) => e.kind === "deadline" && e.date > BUILD_TIME);
const stats: Stat[] = [
  { label: hub.home.statsLive, value: String(allLive.length), icon: "tag", href: localePath(lang, "deals") },
  { label: hub.home.statsTools, value: String(tools.length), icon: "layers", href: localePath(lang, "tools") },
  {
    label: hub.home.statsDeadline,
    value: nextDeadline ? formatDate(nextDeadline.date, lang, { year: undefined }) : "—",
    icon: "calendar",
    href: localePath(lang, "calendar"),
  },
  { label: hub.home.statsLanguages, value: String(i18n.locales.length), icon: "globe" },
];

const snippets = [
  {
    id: "curl",
    label: "curl",
    code: `curl -s ${SITE_URL}/api/status | python3 -c "import sys,json;d=json.load(sys.stdin);print(d['emoji'],d['label'])"`,
  },
  {
    id: "zsh",
    label: "zsh",
    code: `# ~/.zshrc
claude_status() {
  curl -s ${SITE_URL}/api/status | \\
    python3 -c "import sys,json;d=json.load(sys.stdin);print(d['emoji'])" 2>/dev/null || echo '⏳'
}
RPROMPT='$(claude_status)'`,
  },
  { id: "deals", label: "deals", code: `curl -s "${SITE_URL}/api/deals?status=active" | python3 -m json.tool` },
];

const url = absoluteUrl(localePath(lang));
const jsonLd = [
  webPageNode({
    url,
    name: dict.meta.title,
    description: dict.meta.description,
    lang,
    dateModified: lastVerified(deals),
    speakable: ["h1", ".hero-summary", ".peak-answer"],
  }),
  faqNode(dict.faq.items, url),
  itemListNode(
    hub.home.dealsTitle,
    live.map((d) => ({ name: localize(d.title, lang), url: absoluteUrl(dealPath(lang, d.id)) })),
  ),
];
---

<BaseLayout
  lang={lang}
  dict={dict}
  title={dict.meta.title}
  description={dict.meta.description}
  ogTitle={dict.meta.ogTitle}
  ogDescription={dict.meta.ogDescription}
  jsonLd={jsonLd}
>
  <section class="relative isolate overflow-hidden border-b">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(var(--color-border)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_40%,transparent_100%)] bg-size-[22px_22px]"
    >
    </div>
    <div
      class="mx-auto grid w-full max-w-6xl gap-6 px-4 pt-8 pb-10 [grid-template-areas:'heading'_'watch'_'actions'] sm:px-6 sm:pt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,440px)] lg:gap-x-14 lg:gap-y-8 lg:pt-20 lg:pb-16 lg:[grid-template-areas:'heading_watch'_'actions_watch']"
    >
      <div class="[grid-area:heading] lg:self-end">
        <HeroHeading hub={hub} />
      </div>
      <div class="[grid-area:watch] lg:self-center">
        <ClaudeWatch
          client:load
          lang={lang}
          hero={dict.hero}
          watch={hub.claudeWatch}
          common={hub.common}
          deals={claudeDeals}
          links={links}
          buildTime={BUILD_TIME}
          peakEnabled={PEAK_HOURS.enabled}
          hubTranslated={isHubTranslated(lang)}
          caseClass={caseClass}
        />
      </div>
      <div class="[grid-area:actions] lg:self-start">
        <HeroActions
          hub={hub}
          dealsHref={localePath(lang, "deals")}
          toolsHref={localePath(lang, "tools")}
          featuredTools={["claude", "gemini", "cursor", "perplexity", "notion", "elevenlabs"].map((s) => byTool.get(s)!).filter(Boolean)}
          liveCount={allLive.length}
        />
      </div>
    </div>
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 pb-10 sm:px-6 lg:pb-14">
      <SponsorItem dict={dict} />
      <StatCards stats={stats} />
    </div>
  </section>

  {
    live.length > 0 && (
      <Section
        id="live-deals"
        title={hub.home.dealsTitle}
        description={hub.home.dealsSubtitle}
        actionHref={localePath(lang, "deals")}
        actionLabel={hub.home.dealsCta}
        muted
      >
        <div data-live-list class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {live.slice(0, 6).map((deal) => (
            <div>
              <DealCard deal={deal} tool={byTool.get(deal.tool)} lang={lang} hub={hub} now={BUILD_TIME} />
            </div>
          ))}
        </div>
        <AffiliateNote lang={lang} hub={hub} />
      </Section>
    )
  }

  <Section id="schedule" title={hub.home.peakTitle}>
    {peakSource && <PeakFacts dict={dict} source={{ label: peakSource.sourceLabel, url: peakSource.sourceUrl }} />}
    <h3 class="text-lg font-semibold tracking-tight">{hub.home.scheduleTitle}</h3>
    <ScheduleCard dict={dict} rows={scheduleRows(BUILD_TIME)} />
  </Section>

  <Section
    id="tools"
    title={hub.home.toolsTitle}
    description={hub.home.toolsSubtitle}
    actionHref={localePath(lang, "tools")}
    actionLabel={hub.home.toolsCta}
    muted
  >
    <ToolTiles tools={tools.slice(0, 18)} lang={lang} live={liveByTool} />
  </Section>

  <Section id="promotion-history" title={hub.home.historyTitle} description={hub.home.historySubtitle}>
    <DealTimeline deals={history} lang={lang} hub={hub} />
  </Section>

  <Section id="faq" title={dict.faq.title} titleClassName={caseClass} muted>
    <FaqAccordion client:visible items={dict.faq.items} />
  </Section>

  <Section id="developer-tools" title={dict.devTools.title} description={dict.devTools.subtitle} titleClassName={caseClass}>
    <ApiTabs
      client:visible
      title={dict.devTools.apiTitle}
      description={dict.devTools.apiDescription}
      copyLabel={hub.common.copy}
      copiedLabel={hub.common.copied}
      snippets={snippets}
      links={[
        { href: "/api/status", label: "/api/status" },
        { href: "/api/deals", label: "/api/deals" },
      ]}
    />
  </Section>
</BaseLayout>
