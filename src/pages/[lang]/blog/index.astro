---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { i18n, type Locale } from "@/lib/i18n/config";
import { getDictionary } from "@/lib/i18n/dictionaries";
import { getPosts } from "@/lib/content";
import { cardImage } from "@/lib/blog-images";
import { ORG_ID, blogNode, breadcrumbNode, itemListNode, webPageNode } from "@/lib/jsonld";
import { absoluteUrl, blogPath, localePath } from "@/lib/seo";
import { BlogCard, BlogIndexHeader } from "@/components/site/Blog";

export function getStaticPaths() {
  return i18n.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const dict = getDictionary(lang);
const { hub } = dict;
const t = hub.blog;
const posts = await getPosts(lang);
const [lead, ...rest] = posts;
const images = await Promise.all(posts.map((post, i) => (post.image ? cardImage(post.image, i === 0) : undefined)));
const hrefOf = (slug: string) => blogPath(lang, slug);

const url = absoluteUrl(blogPath(lang));
const jsonLd = [
  webPageNode({
    url,
    name: t.metaTitle,
    description: t.metaDescription,
    lang,
    type: "CollectionPage",
    dateModified: posts.length ? Math.max(...posts.map((p) => p.updatedAt)) : undefined,
    breadcrumb: `${url}#breadcrumb`,
    authorId: ORG_ID,
  }),
  blogNode({
    url,
    lang,
    name: t.title,
    description: t.subtitle,
    posts: posts.map((post) => ({
      url: absoluteUrl(hrefOf(post.slug)),
      headline: post.title,
      publishedAt: post.publishedAt,
      updatedAt: post.updatedAt,
    })),
  }),
  itemListNode(
    t.latest,
    posts.map((post) => ({ name: post.title, url: absoluteUrl(hrefOf(post.slug)) })),
  ),
  breadcrumbNode(
    [
      { name: "PromoClock", path: localePath(lang) },
      { name: hub.nav.blog, path: blogPath(lang) },
    ],
    `${url}#breadcrumb`,
  ),
];
---

<BaseLayout lang={lang} dict={dict} path="blog" title={t.metaTitle} description={t.metaDescription} jsonLd={jsonLd} hub>
  <BlogIndexHeader lang={lang} hub={hub} rssHref={`${blogPath(lang)}rss.xml`} />
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-8 sm:gap-12 sm:px-6 sm:py-10">
    {lead && <BlogCard post={lead} image={images[0]} href={hrefOf(lead.slug)} lang={lang} hub={hub} headingLevel="h2" featured />}
    {
      rest.length > 0 && (
        <section class="flex flex-col gap-4" aria-labelledby="latest-posts">
          <h2 id="latest-posts" class="text-xl font-semibold tracking-tight">
            {t.latest}
          </h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((post, i) => (
              <BlogCard post={post} image={images[i + 1]} href={hrefOf(post.slug)} lang={lang} hub={hub} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
