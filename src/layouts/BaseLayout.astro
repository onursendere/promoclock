---
import "@/styles/global.css";
import type { Locale } from "@/lib/i18n/config";
import { hubLocales, isHubTranslated, type UiDictionary } from "@/lib/i18n/dictionaries";
import { siteNodes } from "@/lib/jsonld";
import { IS_STAGING, SITE_NAME } from "@/lib/site";
import { absoluteUrl, alternateLinks, localePath } from "@/lib/seo";
import { i18n, localeNames } from "@/lib/i18n/config";
import { AUTHOR } from "@/lib/site";
import SiteHeader from "@/components/islands/SiteHeader";
import { SiteFooter } from "@/components/site/SiteFooter";
import { CoffeeButton } from "@/components/site/CoffeeButton";

interface Props {
  lang: Locale;
  dict: UiDictionary;
  /** Path after the locale, e.g. "" or "deals" or "tools/cursor". */
  path?: string;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Page-specific schema.org nodes; merged into one @graph with site-wide nodes. */
  jsonLd?: object[];
  noindex?: boolean;
  /** Hub pages (deals, tools, calendar, about) fall back to English until translated. */
  hub?: boolean;
}

const { lang, dict, path = "", title, description, ogTitle, ogDescription, jsonLd = [], noindex = false, hub = false } =
  Astro.props;
// An untranslated hub page is English content under another locale: point it at the English
// original and only advertise the languages that really have it.
const untranslated = hub && !isHubTranslated(lang);
const canonical = absoluteUrl(localePath(untranslated ? "en" : lang, path));
const alternates = alternateLinks(path).filter(
  (alt) => !hub || alt.hreflang === "x-default" || (hubLocales as string[]).includes(alt.hreflang),
);
const htmlLang = untranslated ? "en" : lang;
const graph = { "@context": "https://schema.org", "@graph": [...siteNodes(), ...jsonLd] };
const robots = IS_STAGING || noindex ? "noindex, nofollow" : "index, follow";
const ogImage = absoluteUrl(`/og/${path || "home"}.png`);

const pathname = Astro.url.pathname;
const nav = dict.hub.nav;
const section = (slug: string) => localePath(lang, slug);
const navItems = [
  { href: localePath(lang), label: nav.claude, active: pathname === localePath(lang) },
  { href: section("deals"), label: nav.deals, active: pathname.startsWith(section("deals")) },
  { href: section("tools"), label: nav.tools, active: pathname.startsWith(section("tools")) },
  { href: section("calendar"), label: nav.calendar, active: pathname.startsWith(section("calendar")) },
  { href: `${localePath(lang)}#developer-tools`, label: nav.api, active: false },
];
---

<!doctype html>
<html lang={htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang.replace("-", "_")} />
    <meta name="author" content="Onur Şendere" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@onursendere" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("pc-theme");
          var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>

    {
      !IS_STAGING && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MN3F77SZVF" />
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-MN3F77SZVF");
          </script>
        </>
      )
    }

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
      >Skip to content</a
    >
    <SiteHeader
      client:load
      lang={lang}
      homeHref={localePath(lang)}
      items={navItems}
      locales={i18n.locales.map((code) => ({ code, name: localeNames[code] }))}
      labels={{ language: nav.language, theme: nav.theme, menu: nav.menu }}
      notifications={{
        titles: { offPeak: dict.hero.promotionActive, peak: dict.hero.promotionInactive },
        bodies: { offPeak: dict.hero.activeSubtitle, peak: dict.hero.inactiveSubtitle },
      }}
      repo={AUTHOR.repo}
    />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} dict={dict} />
    <CoffeeButton />
    <script>
      import "@/scripts/live";
    </script>
  </body>
</html>
