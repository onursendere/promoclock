---
import type { ToolCategory } from "@/lib/deals";

interface Props {
  name: string;
  category: ToolCategory;
  size?: "sm" | "md" | "lg";
}
const { name, category, size = "md" } = Astro.props;

const palette: Record<ToolCategory, string> = {
  chat: "bg-primary/12 text-primary",
  coding: "bg-info/12 text-info",
  image: "bg-[#B4552D]/12 text-[#B4552D] dark:text-[#F0A07C]",
  video: "bg-destructive/12 text-destructive",
  audio: "bg-[#7A5A12]/12 text-[#7A5A12] dark:text-[#E3C06E]",
  writing: "bg-success/12 text-success",
  productivity: "bg-[#2D2B6E]/12 text-[#2D2B6E] dark:text-[#A7A4EE]",
  agents: "bg-[#6B2D6E]/12 text-[#6B2D6E] dark:text-[#E0A3E3]",
};
const sizes = { sm: "size-8 text-xs", md: "size-10 text-sm", lg: "size-14 text-lg" };
const initials = name
  .replace(/[^\p{L}\p{N} ]/gu, " ")
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();
---

<span
  class:list={["inline-flex shrink-0 items-center justify-center rounded-xl font-bold tracking-tight", palette[category], sizes[size]]}
  aria-hidden="true"
>
  {initials}
</span>
