---
import { Coffee } from "lucide-react";
import { AUTHOR } from "@/lib/site";
---

<a
  href={AUTHOR.coffee}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Buy me a coffee"
  class="fixed right-5 bottom-5 z-40 inline-flex animate-in items-center gap-2 rounded-full bg-[#FFDD00] px-4 py-3 text-sm font-semibold text-black shadow-[0_4px_20px_rgba(0,0,0,0.15)] transition-all delay-1000 duration-500 fill-mode-both zoom-in-90 fade-in hover:scale-110 hover:shadow-[0_6px_28px_rgba(0,0,0,0.25)] active:scale-100"
>
  <Coffee size={18} strokeWidth={2.5} />
  <span class="hidden sm:inline">Buy me a coffee</span>
</a>
