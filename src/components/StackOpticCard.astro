---
import type { UiDictionary } from "@/lib/i18n/dictionaries";

interface Props {
  dict: UiDictionary;
}
const { dict } = Astro.props;
---

<a
  href="https://stackoptic.com?ref=promoclock&utm_source=promoclock&utm_campaign=solo50"
  target="_blank"
  rel="noopener sponsored"
  class="pc-ring group mx-auto flex w-full max-w-xl flex-col overflow-hidden rounded-2xl border border-transparent bg-card text-card-foreground transition-colors hover:border-sponsor/40"
>
  <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:gap-4 sm:px-6">
    <img
      src="/stackoptic-logo.png"
      alt="StackOptic"
      width="160"
      height="36"
      loading="lazy"
      class="h-8 w-auto shrink-0 self-center mix-blend-multiply sm:h-9 sm:self-auto dark:mix-blend-normal dark:brightness-0 dark:invert"
    />
    <span class="hidden h-10 w-px shrink-0 bg-border sm:block"></span>
    <div class="flex min-w-0 flex-1 flex-col items-center gap-0.5 text-center sm:items-start sm:text-left">
      <span class="text-sm leading-snug font-semibold transition-colors group-hover:text-sponsor sm:text-[15px]">
        {dict.sponsors.stackopticHeadline}
      </span>
      <span class="text-xs leading-snug text-muted-foreground">{dict.sponsors.stackopticSub}</span>
    </div>
  </div>
  <div
    class="relative flex flex-wrap items-center justify-center gap-x-3 gap-y-2 overflow-hidden bg-linear-to-r from-[#2D2B6E] via-[#3b3899] to-[#2D2B6E] px-4 py-3 text-white sm:justify-between sm:px-5 sm:py-3.5"
  >
    <span
      class="pc-shimmer pointer-events-none absolute inset-0 bg-linear-to-r from-transparent via-white/20 to-transparent"
      aria-hidden="true"></span>
    <span
      class="relative shrink-0 rounded-full border border-white/30 bg-white/15 px-2.5 py-1 text-[10px] font-extrabold tracking-[0.16em] whitespace-nowrap uppercase sm:text-[11px]"
    >
      {dict.sponsors.stackopticPromoBadge}
    </span>
    <span class="relative min-w-0 flex-1 px-1 text-center text-sm leading-tight font-bold sm:text-[15px]">
      {dict.sponsors.stackopticPromo}
    </span>
    <span
      class="relative shrink-0 rounded-md bg-white px-3 py-1.5 font-mono text-xs font-extrabold tracking-widest whitespace-nowrap text-[#2D2B6E] shadow-sm sm:text-sm"
    >
      {dict.sponsors.stackopticCode}
    </span>
  </div>
</a>
