---
interface Props {
  size?: number;
  showText?: boolean;
}
const { size = 28, showText = true } = Astro.props;
---

<span class="inline-flex items-center gap-2">
  <svg width={size} height={size} viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <circle cx="78" cy="18" r="8" fill="#8B9A6B"></circle>
    <circle cx="46" cy="50" r="42" fill="#D4C5A9"></circle>
    <path d="M34 30 L58 50 L34 70" stroke="#4A4458" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"
    ></path>
  </svg>
  {
    showText && (
      <span class="font-sans text-lg font-semibold tracking-tight">
        <span class="text-primary">Promo</span>
        <span class="text-foreground">Clock</span>
      </span>
    )
  }
</span>
