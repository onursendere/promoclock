---
import { Check, FileSpreadsheet, Monitor, Smartphone, Terminal, Users, X } from "lucide-react";
import type { UiDictionary } from "@/lib/i18n/dictionaries";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  dict: UiDictionary;
}
const { dict } = Astro.props;
const platformIcons = [Monitor, Monitor, Smartphone, Users, Terminal, FileSpreadsheet];
---

<section id="eligibility" class="scroll-mt-20 px-4 py-24" aria-label={dict.eligibility.title}>
  <div class="mx-auto max-w-5xl">
    <SectionHeading title={dict.eligibility.title} subtitle={dict.eligibility.subtitle} />
    <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        dict.eligibility.plans.map((plan) => (
          <div class:list={["rounded-2xl border bg-card p-6", plan.status ? "border-success/30" : "border-border"]}>
            <div class="mb-3 flex items-center justify-between">
              <h3 class="text-lg">{plan.name}</h3>
              <span
                class:list={[
                  "inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium",
                  plan.status ? "bg-success/10 text-success" : "bg-muted text-muted-foreground",
                ]}
              >
                {plan.status ? <Check size={12} strokeWidth={3} /> : <X size={12} strokeWidth={3} />}
                {plan.status ? dict.eligibility.eligible : dict.eligibility.notEligible}
              </span>
            </div>
            <p class="text-sm leading-relaxed text-muted-foreground">{plan.description}</p>
          </div>
        ))
      }
    </div>
    <div class="rounded-2xl border bg-card p-8">
      <h3 class="mb-5 font-sans text-sm font-semibold tracking-wide">{dict.eligibility.platforms.title}</h3>
      <ul class="grid grid-cols-1 gap-3 min-[400px]:grid-cols-2 sm:grid-cols-3">
        {
          dict.eligibility.platforms.items.map((item, i) => {
            const Icon = platformIcons[i] ?? Monitor;
            return (
              <li class="flex items-center gap-2.5 py-2 text-sm text-secondary-foreground">
                <Icon size={16} className="shrink-0 text-primary" />
                {item}
              </li>
            );
          })
        }
      </ul>
      <p class="mt-6 border-t pt-5 text-sm leading-relaxed text-muted-foreground">{dict.eligibility.note}</p>
    </div>
  </div>
</section>
