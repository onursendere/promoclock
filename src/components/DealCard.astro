---
import { ExternalLink } from "lucide-react";
import type { Locale } from "@/lib/i18n/config";
import type { UiDictionary } from "@/lib/i18n/dictionaries";
import { dealHref, localize, type DealRecord, type ToolRecord } from "@/lib/deals";
import { localePath } from "@/lib/seo";
import { BUILD_TIME } from "@/lib/site";
import { formatDate } from "@/lib/time";
import { Badge } from "@/components/ui/badge";
import ToolAvatar from "@/components/ToolAvatar.astro";
import DealTimer from "@/components/islands/DealTimer";
import CopyButton from "@/components/islands/CopyButton";

interface Props {
  deal: DealRecord;
  tool?: ToolRecord;
  lang: Locale;
  dict: UiDictionary;
  /** Hide the tool row (e.g. on the tool's own page). */
  hideTool?: boolean;
  headingLevel?: "h2" | "h3";
}

const { deal, tool, lang, dict, hideTool = false, headingLevel: Heading = "h3" } = Astro.props;
const { common, kinds } = dict.hub;
const cta = dealHref(deal, tool);
const startKnown = deal.startKnown !== false;
const dateRange = deal.endsAt
  ? startKnown
    ? `${formatDate(deal.startsAt, lang)} – ${formatDate(deal.endsAt, lang)}`
    : `→ ${formatDate(deal.endsAt, lang)}`
  : deal.ongoing || !startKnown
    ? null
    : formatDate(deal.startsAt, lang);
---

<article
  data-deal-card
  data-kind={deal.kind}
  data-category={tool?.category}
  class="flex h-full flex-col gap-3 rounded-2xl border bg-card p-5 text-card-foreground transition-shadow hover:shadow-md sm:p-6"
>
  <div class="flex flex-wrap items-center gap-2">
    {
      !hideTool && tool && (
        <a href={localePath(lang, `tools/${tool.slug}`)} class="mr-1 inline-flex items-center gap-2 font-semibold hover:underline">
          <ToolAvatar name={tool.name} category={tool.category} size="sm" />
          {tool.name}
        </a>
      )
    }
    <Badge variant="secondary">{kinds[deal.kind]}</Badge>
    <span class="ml-auto">
      <DealTimer
        client:visible
        startsAt={deal.startsAt}
        endsAt={deal.endsAt}
        ongoing={deal.ongoing}
        buildTime={BUILD_TIME}
        labels={{
          endsIn: common.endsIn,
          startsIn: common.startsIn,
          ended: common.ended,
          ongoing: common.ongoing,
          d: common.days,
          h: common.hours,
          m: common.minutes,
          s: common.seconds,
        }}
      />
    </span>
  </div>

  <Heading class="text-lg leading-snug">{localize(deal.title, lang)}</Heading>
  <p class="text-sm leading-relaxed text-muted-foreground">{localize(deal.summary, lang)}</p>

  <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
    {dateRange && <time>{dateRange}</time>}
    {dateRange && deal.scope && <span aria-hidden="true">·</span>}
    {deal.scope && <span class="font-medium text-secondary-foreground">{localize(deal.scope, lang)}</span>}
    {deal.regions && (dateRange || deal.scope) && <span aria-hidden="true">·</span>}
    {deal.regions && <span>{deal.regions.join(", ")}</span>}
  </div>

  {
    deal.code && (
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold tracking-widest text-muted-foreground uppercase">{common.code}</span>
        <code class="rounded-md border border-dashed border-primary/40 bg-accent px-2.5 py-1 font-mono text-sm font-bold tracking-widest text-accent-foreground">
          {deal.code}
        </code>
        <CopyButton client:visible text={deal.code} label={common.copy} copiedLabel={common.copied} />
      </div>
    )
  }

  <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t pt-4">
    <p class="text-xs text-muted-foreground">
      <a href={deal.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-primary hover:underline">
        {common.source}: {deal.sourceLabel}
        <ExternalLink className="size-3" aria-hidden="true" />
      </a>
      <span class="block sm:inline sm:before:mx-1.5 sm:before:content-['·']">{common.verified} {formatDate(deal.verifiedAt, lang)}</span>
    </p>
    <a
      href={cta.href}
      target="_blank"
      rel={cta.sponsored ? "sponsored noopener" : "noopener"}
      class="inline-flex h-8 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/85"
    >
      {common.getDeal}
      <ExternalLink className="size-3.5" aria-hidden="true" />
    </a>
  </div>
</article>
