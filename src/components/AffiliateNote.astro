---
import type { Locale } from "@/lib/i18n/config";
import type { UiDictionary } from "@/lib/i18n/dictionaries";
import { localePath } from "@/lib/seo";

interface Props {
  lang: Locale;
  dict: UiDictionary;
}
const { lang, dict } = Astro.props;
---

<p class="max-w-2xl text-center text-xs leading-relaxed text-muted-foreground">
  {dict.hub.common.affiliateNote}
  <a href={localePath(lang, "affiliate-disclosure")} class="underline underline-offset-2 hover:text-foreground">
    {dict.hub.common.disclosureLink}
  </a>
</p>
