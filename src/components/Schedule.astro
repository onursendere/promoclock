---
import type { UiDictionary } from "@/lib/i18n/dictionaries";
import { CITY_SCHEDULES, PEAK_HOURS } from "@/data/claude";
import { BUILD_TIME } from "@/lib/site";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  dict: UiDictionary;
}
const { dict } = Astro.props;

// Offsets are computed at build time; the daily rebuild keeps DST changes current.
const ref = new Date(BUILD_TIME);
const peakStart = new Date(Date.UTC(ref.getUTCFullYear(), ref.getUTCMonth(), ref.getUTCDate(), PEAK_HOURS.startUtc));
const peakEnd = new Date(Date.UTC(ref.getUTCFullYear(), ref.getUTCMonth(), ref.getUTCDate(), PEAK_HOURS.endUtc));

const rows = CITY_SCHEDULES.map(({ city, ianaTimezone }) => {
  const time = (d: Date) =>
    new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: ianaTimezone }).format(d);
  const zonePart = (style: "short" | "shortOffset") =>
    new Intl.DateTimeFormat("en-US", { timeZoneName: style, timeZone: ianaTimezone })
      .formatToParts(peakStart)
      .find((p) => p.type === "timeZoneName")?.value ?? "";
  return {
    city,
    timezone: zonePart("short") || ianaTimezone,
    utcOffset: zonePart("shortOffset"),
    peak: `${time(peakStart)} – ${time(peakEnd)}`,
    offPeak: `${time(peakEnd)} – ${time(peakStart)}`,
  };
});
const th = "px-6 py-4 text-left text-xs font-medium tracking-widest whitespace-nowrap text-muted-foreground uppercase";
---

<section id="schedule" class="scroll-mt-20 px-4 py-24" aria-label={dict.schedule.title}>
  <div class="mx-auto max-w-5xl">
    <SectionHeading title={dict.schedule.title} subtitle={dict.schedule.subtitle} />
    <div class="overflow-hidden rounded-2xl border bg-card">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">{dict.schedule.title}</caption>
          <thead>
            <tr class="border-b">
              <th scope="col" class={th}>{dict.schedule.tableHeaders.city}</th>
              <th scope="col" class={th}>{dict.schedule.tableHeaders.timezone}</th>
              <th scope="col" class={th}>{dict.schedule.tableHeaders.peakHours}</th>
              <th scope="col" class={th}>{dict.schedule.tableHeaders.offPeakHours}</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row, i) => (
                <tr class:list={["border-b last:border-0", i % 2 === 1 && "bg-surface-warm/40"]}>
                  <th scope="row" class="px-6 py-3.5 text-left font-medium whitespace-nowrap">
                    {row.city}
                  </th>
                  <td class="px-6 py-3.5 whitespace-nowrap text-muted-foreground">
                    {row.timezone} <span class="text-xs opacity-70">({row.utcOffset})</span>
                  </td>
                  <td class="px-6 py-3.5 whitespace-nowrap text-secondary-foreground">
                    {dict.schedule.weekdayLabel}: {row.peak}
                  </td>
                  <td class="px-6 py-3.5 whitespace-nowrap">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="size-1.5 rounded-full bg-success" aria-hidden="true" />
                      {dict.schedule.weekdayLabel}: {row.offPeak}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="bg-surface-warm/60 px-6 py-4 text-center text-sm text-secondary-foreground">{dict.schedule.weekendLabel}</p>
    </div>
  </div>
</section>
