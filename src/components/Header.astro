---
import type { Locale } from "@/lib/i18n/config";
import { localeNames, i18n } from "@/lib/i18n/config";
import type { UiDictionary } from "@/lib/i18n/dictionaries";
import { localePath } from "@/lib/seo";
import { AUTHOR } from "@/lib/site";
import PromoClockLogo from "@/components/PromoClockLogo.astro";
import LanguageSwitcher from "@/components/islands/LanguageSwitcher";
import ThemeToggle from "@/components/islands/ThemeToggle";
import NotificationBell from "@/components/islands/NotificationBell";
import MobileNav from "@/components/islands/MobileNav";
import { cn } from "@/lib/utils";

interface Props {
  lang: Locale;
  dict: UiDictionary;
  pathname: string;
}

const { lang, dict, pathname } = Astro.props;
const nav = dict.hub.nav;
const items = [
  { href: localePath(lang), label: nav.claude, match: (p: string) => p === localePath(lang) },
  { href: localePath(lang, "deals"), label: nav.deals, match: (p: string) => p.startsWith(localePath(lang, "deals")) },
  { href: localePath(lang, "tools"), label: nav.tools, match: (p: string) => p.startsWith(localePath(lang, "tools")) },
  {
    href: localePath(lang, "calendar"),
    label: nav.calendar,
    match: (p: string) => p.startsWith(localePath(lang, "calendar")),
  },
  { href: `${localePath(lang)}#developer-tools`, label: nav.api, match: () => false },
];
const locales = i18n.locales.map((code) => ({ code, name: localeNames[code] }));
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Main">
    <a href={localePath(lang)} class="flex items-center rounded-md" aria-label="PromoClock home">
      <PromoClockLogo />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        items.map((item) => {
          const active = item.match(pathname);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class={cn(
                  "rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-muted hover:text-foreground",
                  active ? "text-foreground" : "text-muted-foreground",
                )}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="flex items-center gap-1">
      <LanguageSwitcher
        client:idle
        lang={lang}
        locales={locales}
        label={nav.language}
      />
      <NotificationBell
        client:idle
        titles={{ offPeak: dict.hero.promotionActive, peak: dict.hero.promotionInactive }}
        bodies={{ offPeak: dict.hero.activeSubtitle, peak: dict.hero.inactiveSubtitle }}
      />
      <ThemeToggle client:idle label={nav.theme} />
      <a
        href={AUTHOR.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:inline-flex"
        aria-label="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
      </a>
      <MobileNav
        client:idle
        label={nav.menu}
        items={items.map((item) => ({ href: item.href, label: item.label, active: item.match(pathname) }))}
      />
    </div>
  </nav>
</header>
<div class="h-16" aria-hidden="true"></div>
